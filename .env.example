# Contact form delivery. The three forms post straight to Formspree from the
# browser, so there is no function and no server side secret. The VITE_ prefix
# is correct here: Formspree's browser endpoint is public by design, it only
# accepts submissions, and it cannot be called from a server without a secret.
#
# Create a form at https://formspree.io and copy its endpoint, which looks like
# https://formspree.io/f/abcdwxyz
#
# This is the only address the forms deliver to, and it is read in
# src/data/forms.js so the endpoint is never written into a component. If it is
# unset the form reports that it is not set up and sends nothing.
VITE_FORMSPREE_ENDPOINT=

# Supabase Credentials (obtain from Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Site addresses. These are public: the VITE_ prefix means they are bundled into
# the client, which is fine because they are addresses a visitor already has in
# the address bar. They are read in src/sites.js and nowhere else, so a link to
# another site is never written by hand in a component.
#
# VITE_ENMERO_URL is the Enmero website, which is where the contact and demo
# forms live.
#
# VITE_WATCHTOWER_URL is the Watch Tower product domain. Watch Tower is its own
# entry point rather than a page on this site, so this address is used whenever
# the website links to the product.
VITE_ENMERO_URL=https://enmero.in
VITE_WATCHTOWER_URL=https://watchtower.enmero.in
