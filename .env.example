# Contact form delivery. These are read only by the /api/contact function on
# the server. Never prefix them with VITE_, because anything VITE_ prefixed is
# bundled into the public client and would be readable by anyone.
#
# Create the key at https://resend.com/api-keys and set the recipient to the
# inbox that should receive enquiries. Both addresses must be on a domain you
# have verified in Resend, otherwise delivery is rejected.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Supabase Credentials (obtain from Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
