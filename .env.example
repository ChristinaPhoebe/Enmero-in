# Contact form delivery. These are read only by the /api/contact function on
# the server. Never prefix them with VITE_, because anything VITE_ prefixed is
# bundled into the public client and would be readable by anyone.
#
# Create the key at https://resend.com/api-keys
#
# CONTACT_TO_EMAIL is the one and only inbox that receives website enquiries.
# It is the same address the site publishes, so a visitor who prefers email
# reaches the same place the forms deliver to. The function reads it from the
# server and never takes a recipient from the request, so this is the only
# value that decides where an enquiry goes. If it is unset the form reports that
# it is unavailable and sends nothing.
#
# CONTACT_FROM_EMAIL must be on a domain you have verified in Resend, otherwise
# Resend rejects the message.
RESEND_API_KEY=
CONTACT_TO_EMAIL=vorsped04@gmail.com
CONTACT_FROM_EMAIL=

# Supabase Credentials (obtain from Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
